rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lesson/level content: readable by any signed-in user (including
    // guests, via anonymous auth). Writable by any signed-in user for now
    // so the in-app debug seeder (Settings screen, kDebugMode-gated) works
    // without a separate admin setup — TIGHTEN before wider distribution
    // (e.g. restrict writes to a custom "admin" auth claim).
    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /lessons/{lessonId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /content_lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /aptitudeTests/{levelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Per-user data: only that user may read or write their own documents.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /levelProgress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
