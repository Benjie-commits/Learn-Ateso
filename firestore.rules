rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user (including guests, via anonymous auth) can read
    // content, but only a non-anonymous account (i.e. someone who actually
    // signed up) can write it. This is still short of real admin gating —
    // any registered account can seed/edit content, which is acceptable for
    // a small dev team but should move to a custom "admin" auth claim
    // (requires a Cloud Function or Admin SDK script) before wider release.
    // It does close off the bigger risk: a trivially-created anonymous
    // guest vandalizing shared content.
    function isRegisteredUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if isRegisteredUser();

      match /lessons/{lessonId} {
        allow read: if request.auth != null;
        allow write: if isRegisteredUser();
      }
    }

    match /content_lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if isRegisteredUser();
    }

    match /aptitudeTests/{levelId} {
      allow read: if request.auth != null;
      allow write: if isRegisteredUser();
    }

    // Per-user data: only that user may read or write their own documents.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /levelProgress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
